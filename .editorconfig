root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,json,yml,yaml,html,js}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
# CA1861 wants constant array arguments hoisted into static readonly fields.
# In the tests the inline arrays are the test case, and hoisting them would
# put the data further from the assertion.
dotnet_diagnostic.CA1861.severity = none


# CA1873 flags argument evaluation that would be wasted when logging is off. The
# remaining hits are string.Join calls that already sit inside an
# `if (_logger.IsEnabled(...))` block — the rule does not model that guard, so they
# are false positives. Note this is not a licence to log carelessly: CA1848 stays
# ON and is satisfied (all logging goes through source-generated LoggerMessage
# methods in PlaybackStartHandler.Logging.cs), so a new unguarded ILogger call is
# still caught.
# Enabled at all only because some SDKs turn it on and CI builds with -warnaserror;
# it is off by default in the pinned analyzer package.
dotnet_diagnostic.CA1873.severity = none
