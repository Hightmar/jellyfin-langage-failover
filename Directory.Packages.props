<Project>

  <!-- Single source of truth for package versions. Bumping Jellyfin here is the
       only edit needed to target a new server ABI (meta.json targetAbi aside). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Jellyfin.Controller" Version="10.11.8" />
    <PackageVersion Include="Jellyfin.Model" Version="10.11.8" />
  </ItemGroup>

  <ItemGroup Label="Test only">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
